@page
@model DropZone.Pages.AllItemsModel

<h2>Items</h2>

<a asp-page="SellerList">
    <button type="button">Back</button>
</a>

<br />
<br />

<!-- FILTER BUTTONS -->
<a asp-page="AllItems" asp-route-sellerId="@Model.SellerID" asp-route-filter="All">
    <button type="button">All Items</button>
</a>

<a asp-page="AllItems" asp-route-sellerId="@Model.SellerID" asp-route-filter="InDA">
    <button type="button">InDA</button>
</a>

<a asp-page="AllItems" asp-route-sellerId="@Model.SellerID" asp-route-filter="PickedUp">
    <button type="button">Picked Up</button>
</a>

<a asp-page="AllItems" asp-route-sellerId="@Model.SellerID" asp-route-filter="PulledOut">
    <button type="button">Pulled Out</button>
</a>

<br />
<br />

@if (Model.Items.Count > 0)
{
    <table border="1">
        <tr>
            <th>ItemID</th>
            <th>Buyer</th>
            <th>DateDropped</th>
            <th>Price</th>
            <th>HoldingFee</th>
            <th>Status</th>
            <th>Placed</th>
            <th>DatePickedUp</th>
        </tr>

        @foreach (var i in Model.Items)
        {
            <tr>
                <td>@i.ItemID</td>
                <td>@i.BuyerName</td>
                <td>@i.DateDropped</td>
                <td>@i.Price</td>
                <td>@i.HoldingFee</td>
                <td>@i.ItemStatus</td>
                <td>@i.Placed</td>
                <td>@i.DatePickedUp</td>
            </tr>
        }
    </table>
}
else
{
    <p>No items found.</p>
}