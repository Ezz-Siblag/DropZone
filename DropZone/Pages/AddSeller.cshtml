@page
@model DropZone.Pages.AddSellerModel

<h2>Add Seller</h2>

<form method="post">
    <div>
        <label>Seller Name:</label>
        <input type="text" asp-for="SellerName" required />
    </div>

    <div>
        <label>Date Added:</label>
        <input type="date" asp-for="DateAdded" required />
    </div>
    <div>
        <label>Contact Number:</label>
        <input type="text" asp-for="ContactNumber" required />
    </div>

    <br />

    <button type="submit">Add Seller</button>
</form>

@if (Model.Message != null)
{
    <p>@Model.Message</p>
}

<br />

<!-- 🔒 KEEP YOUR ORIGINAL BUTTON STYLE -->
<a asp-page="SellerList">
    <button type="button">Back</button>
</a>